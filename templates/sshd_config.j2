# {{ ansible_managed }} — gpenaud.secured-server
# Pas d Include de sshd_config.d : cloud-init y ecrit « PasswordAuthentication
# yes », et sshd garde la premiere valeur lue. Ce fichier est la seule source.

Port {{ secure_server_ssh_port }}
AddressFamily any

# Cles d hote : ed25519 d abord, RSA pour les vieux clients.
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

# Chiffrement moderne (lignes de la recommandation Mozilla « modern »).
KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512,diffie-hellman-group-exchange-sha256
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
HostKeyAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-256

# Qui entre, et comment : par cle, membre de sshusers, jamais root.
AllowGroups sshusers
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitEmptyPasswords no
AuthenticationMethods publickey
MaxAuthTries 3
MaxSessions 10
LoginGraceTime 30
UsePAM yes

# Pas de tunnels, pas de relais : la machine n est pas un rebond.
AllowTcpForwarding no
AllowStreamLocalForwarding no
AllowAgentForwarding no
GatewayPorts no
PermitTunnel no
X11Forwarding no
PermitUserEnvironment no
HostbasedAuthentication no
IgnoreRhosts yes

# Sessions : la session tombe apres dix minutes sans reponse du client.
ClientAliveInterval 300
ClientAliveCountMax 2
TCPKeepAlive no
Compression no
UseDNS no

# Le journal nomme la cle qui a ouvert la session : c est la trace d audit.
LogLevel VERBOSE
SyslogFacility AUTH

AcceptEnv LANG LC_*
PrintMotd no
{% if secure_server_ssh_sftp %}
Subsystem sftp internal-sftp
{% endif %}
